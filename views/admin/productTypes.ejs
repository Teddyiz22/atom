<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <div>
    <h1 class="h3 mb-0 text-gray-800">
      <i class="fas fa-tags text-primary mr-2"></i>
      Product Types
    </h1>
    <p class="text-muted mb-0">Add or edit game / product type names shown in the shop</p>
  </div>
  <a href="/admin" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
    <i class="fas fa-arrow-left fa-sm text-white-50"></i> Back to Dashboard
  </a>
</div>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success">
    <i class="fas fa-check-circle mr-2"></i>
    Saved.
  </div>
<% } %>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger">
    <i class="fas fa-exclamation-triangle mr-2"></i>
    <%= error %>
  </div>
<% } %>

<% const isEditing = !!(form && form.id); %>

<div class="row">
  <div class="col-lg-5">
    <div class="card shadow mb-4">
      <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary"><%= isEditing ? 'Edit Product Type' : 'Add Product Type' %></h6>
        <% if (isEditing) { %>
          <a href="/admin/product-types" class="btn btn-sm btn-outline-secondary">Cancel</a>
        <% } %>
      </div>
      <div class="card-body">
        <form method="POST" action="/admin/product-types/save">
          <input type="hidden" name="id" value="<%= form?.id || '' %>">

          <div class="form-group">
            <label for="name">Display Name <span class="text-danger">*</span></label>
            <input
              type="text"
              class="form-control"
              id="name"
              name="name"
              required
              maxlength="128"
              placeholder="e.g. Magic Chess: Go Go"
              value="<%= form?.name || '' %>"
            >
            <small class="form-text text-muted">This name is shown on the shop. You can set any label you want.</small>
          </div>

          <div class="form-group">
            <label for="provider">Provider <span class="text-danger">*</span></label>
            <select class="form-control" id="provider" name="provider" required>
              <option value="smile" <%= form?.provider === 'smile' ? 'selected' : '' %>>smile</option>
              <option value="g2bulk" <%= form?.provider === 'g2bulk' ? 'selected' : '' %>>g2bulk</option>
              <option value="manual" <%= form?.provider === 'manual' ? 'selected' : '' %>>manual</option>
            </select>
          </div>

          <div class="form-group">
            <label for="type_code">Type Code <span class="text-danger">*</span></label>
            <input
              type="text"
              class="form-control"
              id="type_code"
              name="type_code"
              required
              maxlength="32"
              placeholder="e.g. mcgg, ml, pubgm"
              value="<%= form?.type_code || '' %>"
              <%= isEditing ? 'readonly' : '' %>
            >
            <small class="form-text text-muted">
              <%= isEditing
                ? 'Type code cannot be changed after create (used by shop routes).'
                : 'Lowercase code used in URLs and API (e.g. /shop/mcgg).' %>
            </small>
          </div>

          <div class="form-group">
            <label for="status">Status</label>
            <select class="form-control" id="status" name="status" required>
              <option value="active" <%= (form?.status || 'active') === 'active' ? 'selected' : '' %>>active</option>
              <option value="inactive" <%= form?.status === 'inactive' ? 'selected' : '' %>>inactive</option>
            </select>
          </div>

          <button type="submit" class="btn btn-primary">
            <i class="fas fa-save mr-2"></i>
            <%= isEditing ? 'Update' : 'Add' %>
          </button>
          <% if (isEditing) { %>
            <a href="/admin/product-types" class="btn btn-light ml-1">Cancel</a>
          <% } %>
        </form>
      </div>
    </div>
  </div>

  <div class="col-lg-7">
    <div class="card shadow mb-4">
      <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">All Product Types</h6>
        <span class="small text-muted"><%= productTypes?.length || 0 %> records</span>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-bordered table-hover">
            <thead class="thead-light">
              <tr>
                <th>ID</th>
                <th>Provider</th>
                <th>Type Code</th>
                <th>Name</th>
                <th>Status</th>
                <th style="width: 100px;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (!productTypes || productTypes.length === 0) { %>
                <tr>
                  <td colspan="6" class="text-center text-muted">No product types yet.</td>
                </tr>
              <% } else { %>
                <% productTypes.forEach(pt => { %>
                  <tr class="<%= form?.id == pt.id ? 'product-type-row-editing' : '' %>">
                    <td><%= pt.id %></td>
                    <td><%= pt.provider %></td>
                    <td><code><%= pt.typeCode %></code></td>
                    <td><strong><%= pt.name %></strong></td>
                    <td>
                      <span class="badge badge-<%= pt.status === 'active' ? 'success' : 'secondary' %>">
                        <%= pt.status %>
                      </span>
                    </td>
                    <td class="text-center text-nowrap">
                      <a class="btn btn-sm btn-warning" href="/admin/product-types/edit/<%= pt.id %>" title="Edit name">
                        <i class="fas fa-edit"></i>
                      </a>
                      <form method="POST" action="/admin/product-types/toggle" class="d-inline-block m-0">
                        <input type="hidden" name="id" value="<%= pt.id %>">
                        <button type="submit" class="btn btn-sm btn-<%= pt.status === 'active' ? 'secondary' : 'success' %>" title="<%= pt.status === 'active' ? 'Deactivate' : 'Activate' %>">
                          <i class="fas fa-<%= pt.status === 'active' ? 'ban' : 'check' %>"></i>
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  tr.product-type-row-editing > td {
    background: rgba(99, 102, 241, 0.22) !important;
    color: #f8fafc !important;
    box-shadow: inset 3px 0 0 #818cf8;
  }
  tr.product-type-row-editing > td code,
  tr.product-type-row-editing > td strong {
    color: #ffffff !important;
  }
  tr.product-type-row-editing:hover > td {
    background: rgba(99, 102, 241, 0.32) !important;
  }
</style>
