<style>
  /* Fix the "Show entries" dropdown */
  .dataTables_length select {
    background-color: rgba(255, 255, 255, 0.05) !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
    border-radius: 6px !important;
    color: white !important;

    padding: 6px 30px 6px 12px !important; 
    min-width: 100px !important;
    font-size: 14px !important;
    cursor: pointer;

    appearance: auto !important;
    -webkit-appearance: auto !important;
  }

  .dataTables_length {
    margin-bottom: 15px !important;
    color: #9ca3af !important; 
  }
</style>
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%
    const typeCodeLower = String(productType?.typeCode || '').trim().toLowerCase();
    const isG2bulkVirtual = provider === 'g2bulk';
    const isMcggCustomManual = provider === 'manual' && typeCodeLower === 'mcggcustom';
    const fmt = (n) => {
      const v = Number(n);
      if (!Number.isFinite(v)) return '-';
      return v.toLocaleString(undefined, { maximumFractionDigits: 2 });
    };
  %>
  <div class="flex items-start justify-between gap-4 border-b border-white/10 pb-5 mb-8">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
        <span class="<%= provider === 'smile' ? 'text-indigo-300' : (provider === 'manual' ? 'text-amber-300' : 'text-teal-300') %>"><%= provider %></span> Products
        <span class="text-gray-200">- <%= productType.name %></span>
      </h1>
      <p class="text-sm text-gray-300 mt-2">Type Code: <span class="font-mono text-gray-200"><%= productType.typeCode %></span></p>
    </div>
    <div class="flex items-center gap-2">
      <% if (provider === 'smile' || provider === 'manual') { %>
        <a href="/admin/product-management/<%= provider %>/<%= productType.typeCode %>/new" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-sm font-semibold text-white transition-colors">
          Add Product
          <i class="fas fa-plus text-xs"></i>
        </a>
      <% } %>
      <a href="/admin/product-management/<%= provider %>" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-sm font-semibold text-gray-100 transition-colors">
        <svg class="h-4 w-4 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back
      </a>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="mb-6 rounded-xl border border-emerald-500/20 bg-emerald-500/10 px-4 py-3 text-emerald-200">
      Saved.
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="mb-6 rounded-xl border border-red-500/20 bg-red-500/10 px-4 py-3 text-red-200">
      <%= error %>
    </div>
  <% } %>

  <% if (typeof syncMessage !== 'undefined' && syncMessage) { %>
    <div class="mb-6 rounded-xl border border-sky-500/20 bg-sky-500/10 px-4 py-3 text-sky-200">
      <%= syncMessage %>
    </div>
  <% } %>

  <% if (provider === 'smile') { %>
    <div class="rounded-2xl border border-white/10 bg-white/5 p-5 mb-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="text-lg font-semibold text-white">Smile Coin Sync</h2>
          <% if (smileProductSlug) { %>
            <p class="text-sm text-gray-400 mt-1">
              Smile product slug: <span class="font-mono text-indigo-300"><%= smileProductSlug %></span>
            </p>
          <% } %>
        </div>
        <form method="POST" action="/admin/product-management/smile/<%= productType.typeCode %>/sync-smile-coins" class="m-0">
          <input type="hidden" name="type_code" value="<%= productType.typeCode %>">
          <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-sm font-semibold text-white transition-colors">
            Sync Smile Coins from API
          </button>
        </form>
      </div>
    </div>
  <% } %>

  <% if (isG2bulkVirtual) { %>
    <div class="rounded-2xl border border-white/10 bg-white/5 p-5 mb-6">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <div>
          <h2 class="text-lg font-semibold text-white">Shop Categories</h2>
          <p class="text-sm text-gray-400 mt-1">Order controls section order on the shop page. Attach packages below.</p>
        </div>
      </div>

      <div class="overflow-x-auto mb-4">
        <table class="table table-bordered w-full mb-0">
          <thead>
            <tr>
              <th style="width: 70px;">Order</th>
              <th>Name</th>
              <th style="width: 120px;">Status</th>
              <th style="width: 260px;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (!categories || categories.length === 0) { %>
              <tr>
                <td colspan="4" class="text-center text-muted">No categories yet. Add one below.</td>
              </tr>
            <% } else { %>
              <% categories.forEach((cat, idx) => { %>
                <tr>
                  <td class="text-center font-mono text-gray-300"><%= cat.sortOrder %></td>
                  <td>
                    <form method="POST" action="/admin/product-management/g2bulk/<%= productType.typeCode %>/categories/save" class="flex flex-wrap items-center gap-2 m-0">
                      <input type="hidden" name="id" value="<%= cat.id %>">
                      <input type="hidden" name="sort_order" value="<%= cat.sortOrder %>">
                      <input type="text" name="name" value="<%= cat.name %>" class="bg-white/5 border border-white/10 rounded px-2 py-1 text-white min-w-[160px]" required>
                      <input type="text" name="icon_path" value="<%= cat.iconPath || '' %>" placeholder="Icon path (optional)" class="bg-white/5 border border-white/10 rounded px-2 py-1 text-white text-xs min-w-[180px]">
                      <button type="submit" class="inline-flex items-center h-8 px-3 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold">Save</button>
                    </form>
                    <% if (cat.iconPath) { %>
                      <div class="mt-1"><img src="<%= cat.iconPath %>" alt="" class="h-8 w-8 object-contain rounded"></div>
                    <% } %>
                  </td>
                  <td class="text-center">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold <%= cat.isActive ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' : 'bg-red-500/20 text-red-300 border border-red-500/30' %>">
                      <%= cat.isActive ? 'Active' : 'Inactive' %>
                    </span>
                  </td>
                  <td class="text-center whitespace-nowrap">
                    <form method="POST" action="/admin/product-management/g2bulk/<%= productType.typeCode %>/categories/reorder" class="inline-block m-0">
                      <input type="hidden" name="id" value="<%= cat.id %>">
                      <input type="hidden" name="direction" value="up">
                      <button type="submit" class="inline-flex items-center justify-center h-8 w-8 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-gray-100" <%= idx === 0 ? 'disabled' : '' %>>
                        <i class="fas fa-arrow-up text-xs"></i>
                      </button>
                    </form>
                    <form method="POST" action="/admin/product-management/g2bulk/<%= productType.typeCode %>/categories/reorder" class="inline-block m-0 ml-1">
                      <input type="hidden" name="id" value="<%= cat.id %>">
                      <input type="hidden" name="direction" value="down">
                      <button type="submit" class="inline-flex items-center justify-center h-8 w-8 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-gray-100" <%= idx === categories.length - 1 ? 'disabled' : '' %>>
                        <i class="fas fa-arrow-down text-xs"></i>
                      </button>
                    </form>
                    <form method="POST" action="/admin/product-management/g2bulk/<%= productType.typeCode %>/categories/toggle" class="inline-block m-0 ml-1">
                      <input type="hidden" name="id" value="<%= cat.id %>">
                      <button type="submit" class="inline-flex items-center h-8 px-3 rounded-lg <%= cat.isActive ? 'bg-amber-500/15 hover:bg-amber-500/25 border border-amber-400/20 text-amber-200' : 'bg-emerald-500/15 hover:bg-emerald-500/25 border border-emerald-400/20 text-emerald-200' %> text-xs font-semibold">
                        <%= cat.isActive ? 'Deactivate' : 'Activate' %>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>

      <form method="POST" action="/admin/product-management/g2bulk/<%= productType.typeCode %>/categories/save" class="flex flex-wrap items-end gap-3">
        <div>
          <label class="block text-xs text-gray-400 mb-1">New category name</label>
          <input type="text" name="name" required class="bg-white/5 border border-white/10 rounded px-3 py-2 text-white min-w-[200px]" placeholder="e.g. Special Offers">
        </div>
        <div>
          <label class="block text-xs text-gray-400 mb-1">Icon path (optional)</label>
          <input type="text" name="icon_path" class="bg-white/5 border border-white/10 rounded px-3 py-2 text-white min-w-[200px]" placeholder="/images/uc.png">
        </div>
        <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-teal-600 hover:bg-teal-500 text-sm font-semibold text-white">
          <i class="fas fa-plus text-xs"></i> Add Category
        </button>
      </form>
    </div>
  <% } %>

  <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
    <div class="flex items-center justify-between gap-3 mb-4">
      <h2 class="text-lg font-semibold text-white">Product List</h2>
      <span class="text-xs font-bold uppercase rounded-full bg-white/10 border border-white/10 px-3 py-1 text-gray-200">
        Total: <%= products?.length || 0 %>
      </span>
    </div>

    <div class="overflow-x-auto">
      <table id="providerProductsTable" class="table table-bordered table-hover w-full">
        <thead>
          <tr>
            <% if (isG2bulkVirtual) { %>
              <th>Name</th>
              <th style="width: 110px;">Image</th>
              <th style="width: 160px;">Category</th>
              <th style="width: 120px;">Catalogue</th>
              <th style="width: 120px;">Unit (USD)</th>
              <th style="width: 140px;">Sell MMK</th>
              <th style="width: 140px;">Sell THB</th>
              <th style="width: 100px;">Status</th>
              <th style="width: 90px;">Actions</th>
            <% } else { %>
              <th style="width: 90px;">ID</th>
              <th>Name</th>
              <% if (!isMcggCustomManual) { %>
                <th style="width: 140px;"><%= provider === 'smile' ? 'Amount' : 'Amount' %></th>
              <% } %>
              <% if (provider === 'smile' || provider === 'manual') { %>
                <th style="width: 140px;">Region</th>
              <% } %>
              <% if (provider === 'smile') { %>
                <th style="width: 140px;">Smile Coins</th>
              <% } %>
              <th style="width: 150px;">Price (MMK)</th>
              <th style="width: 150px;">Price (THB)</th>
              <th style="width: 120px;">Status</th>
              <th style="width: 120px;">Featured</th>
              <% if (provider === 'smile') { %>
                <th style="width: 180px;">Smile ID</th>
              <% } %>
              <th style="width: 160px;">Actions</th>
            <% } %>
          </tr>
        </thead>
        <tbody>
          <% if (!products || products.length === 0) { %>
            <tr>
              <td colspan="<%= isG2bulkVirtual ? 9 : (provider === 'smile' ? 11 : (isMcggCustomManual ? 8 : (provider === 'manual' ? 9 : 8))) %>" class="text-center text-muted">No products yet.</td>
            </tr>
          <% } else { %>
            <% products.forEach(p => { %>
              <tr>
                <% if (isG2bulkVirtual) { %>
                  <td>
                    <%= p.name %>
                    <% if (p.is_fixed_price) { %>
                      <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
                        Fixed
                      </span>
                    <% } %>
                  </td>
                  <td class="text-center">
                    <label for="image_<%= p.id %>" class="inline-block cursor-pointer mb-1" title="Click to change image">
                      <img
                        id="preview_<%= p.id %>"
                        src="<%= p.image_path || '' %>"
                        alt=""
                        class="h-10 w-10 object-contain mx-auto rounded border border-white/10 bg-white/5 <%= p.image_path ? '' : 'hidden' %>"
                      >
                      <span id="preview_empty_<%= p.id %>" class="text-xs text-gray-500 block <%= p.image_path ? 'hidden' : '' %>">No image</span>
                    </label>
                    <input
                      type="file"
                      accept="image/*"
                      id="image_<%= p.id %>"
                      class="text-xs text-gray-300 w-full max-w-[120px]"
                      onchange="previewG2bulkImage('<%= p.id %>', this)"
                    >
                  </td>
                  <td>
                    <select id="category_<%= p.id %>" class="w-full bg-white/5 border border-white/10 rounded px-2 py-1 text-white text-sm focus:outline-none focus:border-indigo-500">
                      <option value="">— None —</option>
                      <% (categories || []).forEach(cat => { %>
                        <option value="<%= cat.id %>" <%= String(p.category_id || '') === String(cat.id) ? 'selected' : '' %>>
                          <%= cat.name %><%= cat.isActive ? '' : ' (inactive)' %>
                        </option>
                      <% }) %>
                    </select>
                  </td>
                  <td class="text-center">
                    <% if (p.catalogue_missing) { %>
                      <span class="text-sm font-semibold text-red-400">Not Available</span>
                    <% } else { %>
                      <span class="text-sm font-semibold text-emerald-300">Available</span>
                    <% } %>
                  </td>
                  <td class="text-right"><%= fmt(p.unit_price_usd) %></td>
                  <td>
                    <input type="number" step="any" class="w-full bg-white/5 border border-white/10 rounded px-2 py-1 text-white text-right focus:outline-none focus:border-indigo-500" 
                      id="price_mmk_<%= p.id %>" value="<%= p.price_mmk || '' %>" placeholder="MMK">
                  </td>
                  <td>
                    <input type="number" step="any" class="w-full bg-white/5 border border-white/10 rounded px-2 py-1 text-white text-right focus:outline-none focus:border-indigo-500" 
                      id="price_thb_<%= p.id %>" value="<%= p.price_thb || '' %>" placeholder="THB">
                  </td>
                  <td class="text-center">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold <%= p.is_active ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' : 'bg-red-500/20 text-red-300 border border-red-500/30' %>">
                      <%= p.is_active ? 'Active' : 'Inactive' %>
                    </span>
                  </td>
                  <td class="text-center whitespace-nowrap">
                    <button type="button"
                      title="Save"
                      class="inline-flex items-center justify-center h-7 w-7 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white transition-colors"
                      data-name="<%= p.name %>"
                      onclick="saveFixedPrice(this, '<%= p.id %>', '<%= p.fixed_product_id || '' %>')">
                      <i class="fas fa-save text-xs"></i>
                    </button>
                    <form method="POST" action="/admin/product-management/<%= provider %>/<%= productType.typeCode %>/toggle-status/<%= encodeURIComponent(p.id) %>" class="inline-block m-0 ml-1">
                      <input type="hidden" name="name" value="<%= p.name %>">
                      <input type="hidden" name="price_mmk" value="<%= p.price_mmk || 0 %>">
                      <input type="hidden" name="price_thb" value="<%= p.price_thb || 0 %>">
                      <input type="hidden" name="current_active" value="<%= p.is_active ? '1' : '0' %>">
                      <button type="submit"
                        title="<%= p.is_active ? 'Deactivate' : 'Activate' %>"
                        class="inline-flex items-center justify-center h-7 w-7 rounded-md <%= p.is_active ? 'bg-amber-500/15 hover:bg-amber-500/25 border border-amber-400/20 text-amber-200' : 'bg-emerald-500/15 hover:bg-emerald-500/25 border border-emerald-400/20 text-emerald-200' %> transition-colors">
                        <i class="fas fa-<%= p.is_active ? 'ban' : 'check' %> text-xs"></i>
                      </button>
                    </form>
                  </td>
                <% } else { %>
                  <td><%= p.id %></td>
                  <td><%= p.name %></td>
                  <% if (!isMcggCustomManual) { %>
                    <td><%= (provider === 'smile' || provider === 'manual') ? fmt(p.diamond_amount) : p.diamond_amount %></td>
                  <% } %>
                  <% if (provider === 'smile' || provider === 'manual') { %>
                    <td><span class="uppercase text-xs font-bold px-2 py-1 rounded bg-white/10 text-gray-300"><%= p.region === 'ph' ? 'Philippines' : 'Brazil' %></span></td>
                  <% } %>
                  <% if (provider === 'smile') { %>
                    <td class="text-right">
                      <% if (p.smileCoinAmount != null && p.smileCoinAmount !== '') { %>
                        <span class="font-semibold text-indigo-300"><%= fmt(p.smileCoinAmount) %></span>
                      <% } else { %>
                        <span class="text-red-400 text-sm font-semibold">Not set</span>
                      <% } %>
                    </td>
                  <% } %>
                  <td><%= fmt(p.price_mmk) %></td>
                  <td><%= fmt(p.price_thb) %></td>
                  <td>
                    <form action="/admin/product-management/<%= provider %>/<%= productType.typeCode %>/toggle-status/<%= p.id %>" method="POST" class="inline-block">
                      <button type="submit" class="px-3 py-1 rounded-full text-xs font-semibold <%= p.is_active ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' : 'bg-red-500/20 text-red-300 border border-red-500/30' %>">
                        <%= p.is_active ? 'Active' : 'Inactive' %>
                      </button>
                    </form>
                  </td>
                  <td>
                    <form action="/admin/product-management/<%= provider %>/<%= productType.typeCode %>/toggle-featured/<%= p.id %>" method="POST" class="inline-block">
                      <button type="submit" class="px-3 py-1 rounded-full text-xs font-semibold <%= p.is_featured ? 'bg-yellow-500/20 text-yellow-300 border border-yellow-500/30' : 'bg-gray-500/20 text-gray-400 border border-gray-500/30' %>">
                        <%= p.is_featured ? 'Featured' : 'Normal' %>
                      </button>
                    </form>
                  </td>
                  <% if (provider === 'smile') { %>
                    <td><%= p.smileIDCombination || '' %></td>
                  <% } %>
                  <td class="text-right">
                    <form method="POST" action="/admin/product-management/<%= provider %>/<%= productType.typeCode %>/toggle-status/<%= p.id %>" class="d-inline-block m-0">
                      <button type="submit" class="inline-flex items-center justify-center h-9 px-3 rounded-lg <%= p.is_active ? 'bg-amber-500/15 hover:bg-amber-500/25 border border-amber-400/20 text-amber-200' : 'bg-emerald-500/15 hover:bg-emerald-500/25 border border-emerald-400/20 text-emerald-200' %> transition-colors mr-1">
                        <i class="fas fa-<%= p.is_active ? 'ban' : 'check' %> mr-1"></i>
                        <%= p.is_active ? 'Deactivate' : 'Activate' %>
                      </button>
                    </form>
                    <a class="inline-flex items-center justify-center h-9 w-9 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-gray-100 transition-colors" href="/admin/product-management/<%= provider %>/<%= productType.typeCode %>/edit/<%= p.id %>">
                      <i class="fas fa-edit"></i>
                    </a>
                    <form method="POST" action="/admin/product-management/<%= provider %>/<%= productType.typeCode %>/delete/<%= p.id %>" class="d-inline-block m-0" onsubmit="return confirm('Delete this product?')">
                      <button type="submit" class="inline-flex items-center justify-center h-9 w-9 rounded-lg bg-red-500/15 hover:bg-red-500/25 border border-red-400/20 text-red-200 transition-colors ml-1">
                        <i class="fas fa-trash"></i>
                      </button>
                    </form>
                  </td>
                <% } %>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    $(document).ready(function () {
      $('#providerProductsTable').DataTable({
        order: [[<%= isG2bulkVirtual ? 0 : 1 %>, 'asc']],
        pageLength: <%= isG2bulkVirtual ? 100 : 10 %>
      });
    });

    function previewG2bulkImage(g2bulkId, input) {
      const file = input && input.files && input.files[0];
      const img = document.getElementById('preview_' + g2bulkId);
      const empty = document.getElementById('preview_empty_' + g2bulkId);
      if (!file || !img) return;
      if (!file.type || !file.type.startsWith('image/')) return;

      const url = URL.createObjectURL(file);
      img.onload = function () {
        try { URL.revokeObjectURL(url); } catch (_) {}
      };
      img.src = url;
      img.classList.remove('hidden');
      if (empty) empty.classList.add('hidden');
    }

    function saveFixedPrice(btn, g2bulkId, fixedProductId) {
      const name = btn.getAttribute('data-name');
      const priceMmk = document.getElementById('price_mmk_' + g2bulkId).value;
      const priceThb = document.getElementById('price_thb_' + g2bulkId).value;
      const categoryEl = document.getElementById('category_' + g2bulkId);
      const imageEl = document.getElementById('image_' + g2bulkId);

      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/admin/product-management/g2bulk/save-price';
      form.enctype = 'multipart/form-data';

      const fields = [
        { name: 'g2bulk_product_id', value: g2bulkId },
        { name: 'fixed_product_id', value: fixedProductId || '' },
        { name: 'type_code', value: '<%= productType.typeCode %>' },
        { name: 'name', value: name },
        { name: 'price_mmk', value: priceMmk },
        { name: 'price_thb', value: priceThb },
        { name: 'category_id', value: categoryEl ? categoryEl.value : '' }
      ];

      fields.forEach(data => {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = data.name;
        input.value = data.value;
        form.appendChild(input);
      });

      if (imageEl && imageEl.files && imageEl.files[0]) {
        const fileInput = document.createElement('input');
        fileInput.type = 'file';
        fileInput.name = 'image';
        fileInput.style.display = 'none';
        const dt = new DataTransfer();
        dt.items.add(imageEl.files[0]);
        fileInput.files = dt.files;
        form.appendChild(fileInput);
      }

      document.body.appendChild(form);
      form.submit();
    }
  </script>
</div>
